<?xml version="1.0" encoding="UTF-8"?>
<!--
  生产默认配置。级别、目录可用启动参数或环境变量覆盖，不必改文件、不必打两份 XML：
    -DLOG_LEVEL=DEBUG          业务与 root，默认 INFO
    -DCONSOLE_LOG_LEVEL=DEBUG  仅控制台，默认 INFO（文件仍跟随 LOG_LEVEL）
    -DSQL_LOG_LEVEL=DEBUG      JDBC / java.sql，默认 WARN
    -DLOG_PATH=/var/log/ouyunc 或环境变量 LOG_PATH，默认相对目录 logs
  异步、队列满丢弃策略在 log4j2.component.properties。
-->
<configuration status="WARN" monitorInterval="1800">

    <Properties>
        <property name="applicationName" value="ouyunc-message"/>
        <property name="logFileName" value="${applicationName}"/>
        <!-- 先读 -DLOG_PATH，再读环境变量 LOG_PATH，最后才落到工作目录下的 logs -->
        <property name="log_path">${sys:LOG_PATH:-${env:LOG_PATH:-logs}}</property>
        <property name="basePath">${log_path}/${logFileName}</property>

        <!-- 文件和控制台同一格式。不输出 %l / %C / %M，避免每条日志取调用栈。 -->
        <property name="log_pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} [${logFileName}] [${sys:local-server-address:-127.0.0.1}] [trace-id:%X{trace-id}] [span-id:%X{span-id}] [%-5level] [%t] %c - %msg%n</property>

        <property name="every_file_size">20MB</property>
        <property name="output_log_level">${sys:LOG_LEVEL:-${env:LOG_LEVEL:-INFO}}</property>
        <property name="console_print_level">${sys:CONSOLE_LOG_LEVEL:-${env:CONSOLE_LOG_LEVEL:-INFO}}</property>
        <property name="sql_log_level">${sys:SQL_LOG_LEVEL:-${env:SQL_LOG_LEVEL:-WARN}}</property>

        <property name="rolling_fileName">${basePath}/all.log</property>
        <property name="rolling_filePattern">${basePath}/%d{yyyy-MM}/all-%d{yyyy-MM-dd-HH}-%i.log.gz</property>
        <!-- 同一时间片内的序号上限。历史文件再由下面的 30 天 / 5GB 清理兜住。 -->
        <property name="rolling_max">200</property>
        <property name="rolling_timeInterval">12</property>
        <property name="rolling_timeModulate">true</property>

        <property name="error_fileName">${basePath}/error.log</property>
        <property name="error_filePattern">${basePath}/%d{yyyy-MM}/error-%d{yyyy-MM-dd-HH}-%i.log.gz</property>
        <property name="error_max">100</property>
        <property name="error_timeInterval">1</property>
        <property name="error_timeModulate">true</property>
    </Properties>

    <appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <ThresholdFilter level="${console_print_level}" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${log_pattern}"/>
        </Console>

        <!-- 全量日志。immediateFlush=false 交给异步线程批量刷盘，崩溃时最多丢失末尾一块缓冲区。 -->
        <RollingFile name="All" fileName="${rolling_fileName}" filePattern="${rolling_filePattern}"
                     immediateFlush="false" bufferSize="65536">
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <OnStartupTriggeringPolicy/>
                <TimeBasedTriggeringPolicy interval="${rolling_timeInterval}" modulate="${rolling_timeModulate}"/>
                <SizeBasedTriggeringPolicy size="${every_file_size}"/>
            </Policies>
            <DefaultRolloverStrategy max="${rolling_max}">
                <Delete basePath="${basePath}" maxDepth="2">
                    <IfFileName glob="*/*.log.gz">
                        <IfAny>
                            <!-- 超过 30 天，或归档总量超过 5GB 时从最旧的压缩文件开始删。当前 all.log / error.log 不匹配该 glob。 -->
                            <IfLastModified age="720H"/>
                            <IfAccumulatedFileSize exceeds="5 GB"/>
                        </IfAny>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>

        <!-- 只收 ERROR 和 FATAL。立即刷盘，避免和全量日志共用缓冲区时把错误一起丢掉。 -->
        <RollingFile name="RollingFileError" fileName="${error_fileName}" filePattern="${error_filePattern}"
                     immediateFlush="true">
            <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            <PatternLayout pattern="${log_pattern}"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="${error_timeInterval}" modulate="${error_timeModulate}"/>
                <SizeBasedTriggeringPolicy size="${every_file_size}"/>
            </Policies>
            <DefaultRolloverStrategy max="${error_max}">
                <Delete basePath="${basePath}" maxDepth="2">
                    <IfFileName glob="*/*.log.gz">
                        <IfAny>
                            <IfLastModified age="720H"/>
                            <IfAccumulatedFileSize exceeds="5 GB"/>
                        </IfAny>
                    </IfFileName>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </appenders>

    <loggers>
        <!-- 框架日志钉死，避免 -DLOG_LEVEL=DEBUG 时把 Netty / Spring / Kafka 的调试日志一起打出来。 -->
        <Logger name="com.zaxxer.hikari" level="WARN"/>
        <Logger name="java.sql" level="${sql_log_level}"/>
        <Logger name="org.springframework" level="INFO"/>
        <Logger name="org.springframework.jdbc.core.JdbcTemplate" level="${sql_log_level}"/>
        <Logger name="io.netty" level="INFO"/>
        <Logger name="io.lettuce" level="INFO"/>
        <Logger name="org.mongodb" level="INFO"/>
        <Logger name="com.mongodb" level="INFO"/>
        <!-- JDK 25 下 kafka-clients 3.9.x 会先试 Subject.getSubject() 再回退，DEBUG 会打完整堆栈，不是认证失败 -->
        <Logger name="org.apache.kafka" level="INFO"/>
        <Logger name="org.apache.zookeeper" level="WARN"/>

        <Logger name="com.ouyunc" level="${output_log_level}"/>

        <root level="${output_log_level}">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="All"/>
            <AppenderRef ref="RollingFileError"/>
        </root>
    </loggers>

</configuration>
