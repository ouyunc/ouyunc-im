<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.ouyunc</groupId>
    <artifactId>ouyunc-commons</artifactId>
    <version>${revision}</version>
  </parent>
  <artifactId>ouyunc-repository</artifactId>
  <name>ouyunc-repository</name>
  <version>${revision}</version>
  <description>业务数据操作模块</description>

  <dependencies>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-base</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-id</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-domain</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-core</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-cache</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-db-jdbc</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-db-mongo</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-db-influx</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>com.ouyunc</groupId>
      <artifactId>ouyunc-mq-core</artifactId>
      <version>${revision}</version>
      <optional>true</optional>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 本模块无 @Aspect。父 POM 全局启用 AJC 后，会对 enum 实现接口做增量织入，
           可能把 Repository.checkDup 再写进 DefaultRepository.class，JVM 报
           Duplicate method name "checkDup"（ClassFormatError）。 -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>aspectj-maven-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
